<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- JPA entities require settable mutable relations and expose managed collections;
         defensive copying would break Hibernate's dirty-checking / cascade lifecycle. -->
    <Match>
        <Package name="org.example.pantrypilot.model"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- DTO records (requests + responses) are immutable-by-convention transfer objects.
         Java records auto-generate accessors that return internal refs; defensive copying
         would negate the record's value semantics without a real security benefit here. -->
    <Match>
        <Package name="org.example.pantrypilot.dto"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Spring @RestController / @Configuration classes receive singleton beans via
         constructor DI. The "exposed reference" is a Spring-managed service; no external
         caller ever hands one in, so defensive copying is meaningless here. -->
    <Match>
        <Or>
            <Package name="org.example.pantrypilot.controller"/>
            <Package name="org.example.pantrypilot.config"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- DomainEventPublisher receives KafkaTemplate via constructor DI; it is a Spring-managed
         singleton bean, not domain data, so defensive copying does not apply. -->
    <Match>
        <Class name="org.example.pantrypilot.event.DomainEventPublisher"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- AiChatService + ChatActionService + ChatActionProposer receive Spring-managed beans
         (services, ObjectMapper, Validator) via constructor DI; not domain data, so
         defensive copying does not apply. -->
    <Match>
        <Or>
            <Class name="org.example.pantrypilot.service.AiChatService"/>
            <Class name="org.example.pantrypilot.service.ChatActionService"/>
            <Class name="org.example.pantrypilot.service.ai.ChatActionProposer"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- PantryItemNameResolver.Result wraps a JPA entity + list of entities purely as an
         internal query-result carrier passed within a single request. Callers do not mutate
         these references; the record is a value-object shell. Same story as
         PantryItemExpiringEvent / AiFunctionCall — record semantics without a real
         defensive-copy benefit. -->
    <Match>
        <Class name="org.example.pantrypilot.service.ai.PantryItemNameResolver$Result"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- PantryItemExpiringEvent is an immutable event record: its compact constructor stores
         List.copyOf(items), so the internal list is unmodifiable. SpotBugs still flags the
         auto-generated accessor because it cannot statically prove immutability; suppressing
         EI_EXPOSE_REP here preserves record value semantics without weakening safety. -->
    <Match>
        <Class name="org.example.pantrypilot.event.PantryItemExpiringEvent"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- AiFunctionCall is an immutable record: its compact constructor stores Map.copyOf(args),
         so the internal map is unmodifiable. Same story as PantryItemExpiringEvent above. -->
    <Match>
        <Class name="org.example.pantrypilot.service.ai.AiFunctionCall"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

</FindBugsFilter>
