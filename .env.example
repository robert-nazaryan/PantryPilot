DB_USERNAME=pantrypilot
DB_PASSWORD=changeme

# Host port for Postgres. Override if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432

# JWT signing key. HS256 requires at least 32 bytes (256 bits) of entropy.
# For production, generate one with: openssl rand -base64 48
# NEVER ship the placeholder below.
JWT_SECRET=REPLACE_ME_generate_a_random_secret_of_at_least_32_bytes_length
